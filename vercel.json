{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/admin/(.*\\.(css|js|png|jpg|jpeg|svg|ico))",
            "dest": "/admin_panel/$1"
        },
        {
            "src": "/admin/(.*)",
            "dest": "index.js"
        },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}
